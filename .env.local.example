# One-time setup: cp .env.local.example .env.local
# Start with npm run dev (watch) or npm run start:local.
NODE_ENV=development
ADMIN_TOKEN=clash-local-demo
PORT=8080
DATA_DIR=./data
# Empty: use the address you opened in the browser. Use the Mac's LAN address
# in your browser when copying subscriptions for another device.
PUBLIC_BASE_URL=
REFRESH_INTERVAL_MINUTES=360
ALLOW_PRIVATE_UPSTREAMS=false
FETCH_TIMEOUT_MS=15000
MAX_SUBSCRIPTION_BYTES=10485760
# macOS Clash Verge installation; change once or leave empty to disable web tests.
MIHOMO_BIN="/Applications/Clash Verge.app/Contents/MacOS/verge-mihomo"
LATENCY_TIMEOUT_MS=5000
