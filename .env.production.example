# One-time setup: cp .env.production.example .env.production
# docker compose --env-file .env.production up -d --build
# Generate a secret with: openssl rand -hex 32
ADMIN_TOKEN=
PUBLIC_BASE_URL=https://sub.example.com
# Host port, bound to loopback for a reverse proxy on the host.
PORT=8080
REFRESH_INTERVAL_MINUTES=360
ALLOW_PRIVATE_UPSTREAMS=false
FETCH_TIMEOUT_MS=15000
MAX_SUBSCRIPTION_BYTES=10485760
LATENCY_TIMEOUT_MS=5000
# Docker uses its own /data volume and bundled Mihomo; no macOS paths here.
